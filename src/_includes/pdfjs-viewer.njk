---
layout: base.njk
bodyClass: docs-page
---
{%- set toc = content | toc -%}
{%- macro tocList(items) -%}
<ol>
  {%- for item in items %}
  <li class="toc-l{{ item.level }}"><a href="#{{ item.id }}">{{ item.text }}</a></li>
  {%- endfor %}
</ol>
{%- endmacro -%}
<div class="docs">
  <div class="toc">
    <nav aria-label="Site"><a class="brand toc-home" href="/"><img src="/assets/logo.svg" alt="" width="24" height="24">{{ site.name }}</a></nav>
    <nav aria-label="On this page">{{ tocList(toc) }}</nav>
  </div>

  <main class="content" id="main">
    <header class="docs-header">
      <a class="brand docs-brand" href="/"><img src="/assets/logo.svg" alt="" width="24" height="24">{{ site.name }}</a>
      <div class="docs-header-row">
        <h1>pdfjs-viewer</h1>
        {% include "theme-switch.njk" %}
      </div>
      <p class="lead">A self-hostable PDF viewer web component, based on the <a href="https://mozilla.github.io/pdf.js/web/viewer.html">PDF.js default viewer</a>.</p>
      <ul class="meta">
        <li><a href="{{ pdfjsViewer.npm }}">npm</a></li>
        <li><a href="{{ pdfjsViewer.repo }}">GitHub</a></li>
        <li><a href="{{ pdfjsViewer.repo }}/blob/master/LICENSE">MIT license</a></li>
      </ul>
      <details class="toc-inline">
        <summary>On this page</summary>
        <nav aria-label="On this page">{{ tocList(toc) }}</nav>
      </details>
    </header>

    {{ content | safe }}

    <footer class="docs-footer">
      <p>Found a mistake? <a href="https://github.com/missing-elements/missing-elements.github.io/blob/main/{{ page.inputPath | replace('./', '') }}">Edit this page</a> or <a href="{{ pdfjsViewer.repo }}/issues">open an issue</a>.</p>
    </footer>
  </main>

  <div class="preview" id="preview" role="complementary" aria-label="Live preview" data-preview>
    <div class="preview-bar">
      <span class="preview-title">Live preview</span>
      <button type="button" class="button" data-preview-reset aria-label="Reset preview">Reset</button>
      <button type="button" class="button preview-close" data-preview-close>Close</button>
    </div>
    <div class="preview-stage" data-preview-stage>
      <noscript><p class="preview-note">The preview needs JavaScript.</p></noscript>
    </div>
    <pre class="language-html preview-markup" data-label="Current markup" data-preview-markup-box><code class="language-html" data-preview-markup></code></pre>
    <p class="visually-hidden" role="status" data-status="preview"></p>
  </div>
  <button type="button" class="button preview-open" data-preview-open aria-controls="preview" aria-expanded="false" hidden>Preview</button>
</div>
<script type="module" src="/pdfjs-viewer/docs.js"></script>
