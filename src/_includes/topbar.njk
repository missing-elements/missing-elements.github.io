{#- The bar at the top of every page, as the build page's first was: the site's name, which goes
    home, then links to the page's own sections where it lists them (`topbarLinks` in its front
    matter, each `{ href, text }`, shown only to the visitor `topbarLinksClass` names where it names
    one), and the theme switch. -#}
<header class="topbar">
  <div class="wrap topbar-row">
    <a class="brand" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}><img src="/assets/logo.svg" alt="" width="24" height="24">{{ site.name }}</a>
    <div class="topbar-end">
      {%- if topbarLinks %}
      <nav class="topbar-links{% if topbarLinksClass %} {{ topbarLinksClass }}{% endif %}" aria-label="On this page">
        {%- for link in topbarLinks %}
        <a href="{{ link.href }}">{{ link.text }}</a>
        {%- endfor %}
      </nav>
      {%- endif %}
      {% include "theme-switch.njk" %}
    </div>
  </div>
</header>
