---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
{#- The site's pages, for search engines: what is written as HTML. A data file such as
    /h5p/skill/index.json is a template too, and the skill's files are copied, not written. -#}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in collections.all %}
{%- if entry.outputPath and entry.outputPath.endsWith(".html") %}
  <url><loc>{{ site.url }}{{ entry.url }}</loc></url>
{%- endif %}
{%- endfor %}
</urlset>
